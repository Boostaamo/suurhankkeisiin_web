# Kopioi tiedostoksi .env.local paikalliseen kehitykseen. Älä koskaan commitoi oikeita arvoja.
# Tuotannossa arvot asetetaan Vercelin ympäristömuuttujiin (Asetukset > Ympäristömuuttujat).

# Sivuston julkinen osoite (ilman loppukauttaviivaa)
NEXT_PUBLIC_SITE_URL=https://suurhankkeisiin.fi

# Liidit: Supabase (EU), Suurhankkeisiin.fi:n oma projekti. Vercelin Supabase-integraatio lisää nämä itse.
# Taulu: supabase/migrations/20261124_liidit.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Datalähde (Bistek, repo Boostaamo/suurhankkisiin_data): tiedostot (oletus, content/) tai tietokanta.
# tietokanta: build hakee julkaistut tiedot Supabasen julkisista näkymistä julkisella avaimella (scripts/hae-data.mjs).
DATALAHDE=tiedostot
# Julkinen avain (sb_publishable_… tai vanha anon). Näkee vain julkiset_*-näkymät. Vercelin Supabase-integraatio
# voi lisätä sen nimellä NEXT_PUBLIC_SUPABASE_ANON_KEY, joka käy myös.
SUPABASE_PUBLISHABLE_KEY=

# Valinnainen sähköposti-ilmoitus uudesta liidistä (esim. Apps Script -webhook)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Google Analytics 4 (Suurhankkeisiin.fi). Ladataan vain evästesuostumuksen jälkeen.
# Oletuksena lib/ga.ts (G-92TFFQSY4Q); aseta vain, jos tunnus vaihtuu.
NEXT_PUBLIC_GA_ID=
